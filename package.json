{
  "name": "williamarice-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run monaco:worker && npm run db:setup && next dev",
    "prebuild": "npm run monaco:worker",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:setup": "npm run db:generate && prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "monaco:worker": "node scripts/copy-monaco-worker.mjs",
    "postinstall": "npm run db:generate && npm run monaco:worker"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^5.9.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.4.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "react-spinners": "^0.17.1",
    "react-type-animation": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.32",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.31",
    "prisma": "^7.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "dompurify": "^3.4.17"
  }
}
