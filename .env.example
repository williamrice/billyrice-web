# Application
NODE_ENV=development
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/williamarice
REDIS_URL=redis://localhost:6379

# Better Auth and owner access
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated exact origins permitted to initiate authentication.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://warbox.llama-luma.ts.net
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_SECRET=replace-with-google-client-secret
ALLOWED_AUTH_EMAILS=owner@example.com

# Contact form (optional until the contact feature is enabled)
RESEND_API_KEY=
FROM_EMAIL=
TO_EMAIL=
GCLOUD_API_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Media uploads (optional until the media feature is enabled)
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional external secret-message integration
NEXT_PUBLIC_SECRETMESSAGE_HOSTNAME=
